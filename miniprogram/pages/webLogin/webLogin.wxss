/* 电脑端扫码登录确认页 —— 沿用请柬的米金主题 */
page {
  background: #faf6ef;
}

.wl-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}

.wl-card {
  width: 100%;
  max-width: 620rpx;
  background: #fffdf8;
  border: 1rpx solid #e8dfd0;
  border-radius: 28rpx;
  padding: 64rpx 48rpx 48rpx;
  box-shadow: 0 12rpx 48rpx rgba(140, 115, 80, 0.08);
  text-align: center;
}

.wl-kicker {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: #b8935e;
  margin-bottom: 18rpx;
}

.wl-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #3a332a;
  letter-spacing: 4rpx;
}

.wl-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6f6557;
}

.wl-mark {
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  margin: 56rpx auto 28rpx;
  border-radius: 50%;
  background: #f7efe1;
  color: #9a7743;
  font-size: 52rpx;
  letter-spacing: 2rpx;
}

/* 待确认态：展示小程序头像（与 PC 端码中心同一张），不再用占位字符 */
.wl-avatar {
  width: 148rpx;
  height: 148rpx;
  margin: 56rpx auto 28rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #e8dfd0;
  background: #fffdf8;
  box-shadow: 0 10rpx 30rpx rgba(140, 115, 80, 0.16);
}

.wl-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.wl-mark.is-ok {
  background: #eaf1e6;
  color: #5c7a4c;
}

.wl-mark.is-err {
  background: #f7e9e5;
  color: #a56a5c;
}

.wl-tip,
.wl-msg {
  font-size: 27rpx;
  line-height: 1.7;
  color: #6f6557;
  margin-bottom: 44rpx;
}

.wl-msg.is-err {
  color: #a56a5c;
}

.wl-btn {
  /* flex 双轴居中：不受原生 button 的 padding/line-height/文本空白影响，文字必然居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  width: 100%;
  height: 92rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  border-radius: 46rpx;
  font-size: 31rpx;
  letter-spacing: 4rpx;
  color: #fffdf8;
  background: linear-gradient(135deg, #c2a173, #9a7743);
  border: none;
}

.wl-btn::after {
  border: none;
}

.wl-btn[disabled] {
  opacity: 0.6;
  color: #fffdf8;
}

.wl-btn.ghost {
  background: #fffdf8;
  color: #9a7743;
  border: 1rpx solid #ddc9a4;
}

.wl-foot {
  margin-top: 40rpx;
  font-size: 23rpx;
  color: #a99a86;
}

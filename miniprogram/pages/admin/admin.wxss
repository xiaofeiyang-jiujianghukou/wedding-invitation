/* 管理后台 · 米金纸感主题（与请柬本体一致） */

.ad-root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--ivory);
}

/* ========== 顶部条 ========== */
.ad-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--paper);
  border-bottom: 1rpx solid rgba(184, 147, 94, 0.25);
}

.ad-share {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ad-share-label {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.ad-share-code {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--gold-deep);
}

.ad-share-copy {
  font-size: 22rpx;
  color: var(--gold-deep);
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
}

.ad-pub {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  color: var(--ink-soft);
  background: var(--ivory);
  border: 1rpx solid rgba(111, 101, 87, 0.3);
}

.ad-pub.on {
  color: #fff;
  background: var(--gold);
  border-color: var(--gold);
}

/* ========== Tab ========== */
.ad-tabs {
  display: flex;
  background: var(--paper);
  border-bottom: 1rpx solid rgba(184, 147, 94, 0.2);
}

.ad-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0 22rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
  position: relative;
}

.ad-tab.on {
  color: var(--gold-deep);
  font-weight: 600;
}

.ad-tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 56rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--gold);
}

/* ========== 主体 ========== */
.ad-body {
  flex: 1;
  height: calc(100vh - 300rpx);
  padding: 28rpx 32rpx 60rpx;
}

/* ========== 卡片 ========== */
.ad-card {
  background: var(--paper);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(184, 147, 94, 0.08);
}

.ad-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-deep);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

/* ========== 表单 ========== */
.ad-field {
  margin-bottom: 24rpx;
}

.ad-field:last-child {
  margin-bottom: 0;
}

.ad-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 8rpx;
}

.ad-input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: var(--ivory);
  border: 1rpx solid rgba(184, 147, 94, 0.28);
  border-radius: 12rpx;
}

.ad-textarea {
  width: 100%;
  min-height: 130rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  background: var(--ivory);
  border: 1rpx solid rgba(184, 147, 94, 0.28);
  border-radius: 12rpx;
}

.ad-tip {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
  opacity: 0.8;
}

.ad-field-inline {
  display: flex;
  gap: 16rpx;
}

.ad-input-time {
  width: 160rpx;
  flex: none;
  text-align: center;
}

.ad-input-grow {
  flex: 1;
  min-width: 0;
}

/* 日期/时间选择器（外观与输入框一致，点击弹出系统选择器） */
.ad-picker {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: var(--ivory);
  border: 1rpx solid rgba(184, 147, 94, 0.28);
  border-radius: 12rpx;
}

/* 地图选点按钮 */
.ad-map-btn {
  display: inline-block;
  font-size: 24rpx;
  color: var(--gold-deep);
  padding: 10rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
  background: rgba(184, 147, 94, 0.06);
}

/* ========== 故事/日程行 ========== */
.ad-row {
  padding: 24rpx 0;
  border-bottom: 1rpx dashed rgba(184, 147, 94, 0.3);
}

.ad-row:last-of-type {
  border-bottom: none;
}

.ad-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ad-row-index {
  font-size: 24rpx;
  color: var(--gold-deep);
}

.ad-row-del {
  font-size: 24rpx;
  color: var(--rose);
  padding: 4rpx 16rpx;
}

.ad-add {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--gold-deep);
  padding: 20rpx 0;
  border: 1rpx dashed var(--gold);
  border-radius: 12rpx;
}

/* ========== 按钮 ========== */
.ad-actions {
  margin-top: 32rpx;
}

.ad-btn {
  text-align: center;
  font-size: 30rpx;
  padding: 26rpx 0;
  border-radius: 14rpx;
}

.ad-btn-main {
  color: #fff;
  background: var(--gold);
  letter-spacing: 4rpx;
}

.ad-btn-main.disabled {
  opacity: 0.55;
}

.ad-btn-line {
  display: inline-block;
  padding: 16rpx 48rpx;
  color: var(--gold-deep);
  border: 1rpx solid var(--gold);
  margin-top: 24rpx;
}

.ad-foot-tip {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
  text-align: center;
  margin-top: 24rpx;
  opacity: 0.75;
  line-height: 1.7;
}

/* ========== 相册网格 ========== */
.ad-stat {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx 24rpx;
}

.ad-stat-num {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--gold-deep);
}

.ad-stat-label {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.ad-stat-badge {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--rose);
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--rose);
  border-radius: 999rpx;
}

.ad-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.ad-cell {
  position: relative;
  width: calc((100% - 20rpx) / 2);
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--paper);
  box-shadow: 0 2rpx 12rpx rgba(184, 147, 94, 0.12);
}

.ad-cell-img {
  display: block;
  width: 100%;
  height: 320rpx;
}

.ad-cell-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 12rpx 16rpx;
  background: linear-gradient(rgba(58, 51, 42, 0.45), transparent);
}

.ad-cell-chapter {
  font-size: 22rpx;
  color: #fff;
}

.ad-cell-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--gold);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.ad-cell-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--ivory);
  border-top: 1rpx solid rgba(184, 147, 94, 0.2);
}

.ad-cell-move,
.ad-cell-del {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  color: var(--gold-deep);
}

.ad-cell-del {
  color: var(--rose);
  border-left: 1rpx solid rgba(184, 147, 94, 0.2);
  border-right: 1rpx solid rgba(184, 147, 94, 0.2);
}

.ad-cell-cap {
  padding: 14rpx 16rpx 18rpx;
  background: var(--paper);
}

.ad-cell-cap-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-soft);
}

.ad-cell-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  background: var(--paper);
  border: 1rpx dashed var(--gold);
  box-shadow: none;
}

.ad-add-plus {
  font-size: 60rpx;
  color: var(--gold);
  line-height: 1;
}

.ad-add-text {
  font-size: 24rpx;
  color: var(--gold-deep);
  margin-top: 12rpx;
}

/* ========== AI 面板 ========== */
.ad-para {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.ad-para-dim {
  color: var(--ink-soft);
  font-size: 24rpx;
}

.ad-result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed rgba(184, 147, 94, 0.25);
}

.ad-result-row:last-child {
  border-bottom: none;
}

.ad-result-label {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.ad-result-val {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-deep);
}

/* ========== 状态 ========== */
.ad-loading,
.ad-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.ad-loading-text {
  font-size: 28rpx;
  color: var(--ink-soft);
}

.ad-error-text {
  font-size: 28rpx;
  color: var(--rose);
  text-align: center;
  line-height: 1.8;
}

/* ========== 底部返回条 ========== */
.ad-backbar {
  position: sticky;
  bottom: 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--gold-deep);
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid rgba(184, 147, 94, 0.2);
}
